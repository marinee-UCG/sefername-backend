# Copy to deploy/.env on the server and fill in. deploy/.env never goes into git.

# The address people type, already pointing at this server (DNS A record)
DOMAIN=sefername.example.com
# Let's Encrypt writes here if the certificate is about to run out
ACME_EMAIL=you@example.com

# Long random strings. Make each one with:  openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=
