# Copy to deploy/.env on the server and fill in. deploy/.env never goes into git.

# The address people type, already pointing at this server (DNS A record)
DOMAIN=sefername.example.com
# Let's Encrypt writes here if the certificate is about to run out
ACME_EMAIL=you@example.com

# Long random strings. Make each one with:  openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# Uploaded files (passport scans...) and document numbers are stored encrypted with this key: 32 random bytes, base64.
# Make it with:  openssl rand -base64 32 | tr '+/' '-_'
# Save a copy in your password manager. Lose it and every uploaded file and document number is lost with it.
DATA_ENCRYPTION_KEY=

# Encrypts the nightly backups. A long passphrase (openssl rand -hex 32), also kept in your password manager,
# and never stored next to the backups themselves: whoever has both can read everything.
BACKUP_PASSPHRASE=

# Sign in with Google (optional; leave both empty to hide the button). From Google Cloud > Credentials,
# an OAuth client of type "Web application" with https://<DOMAIN> as an authorized JavaScript origin.
# Public ids, not secrets. The API takes a JSON list (add the iOS client id here later).
GOOGLE_CLIENT_IDS=[]
GOOGLE_WEB_CLIENT_ID=

# Sign in with Apple (optional; needs the Apple Developer Program). From developer.apple.com:
#   APPLE_WEB_CLIENT_ID  the Services ID for the website (e.g. app.sefername.web)
#   APPLE_REDIRECT_URI   https://<DOMAIN>/login, added to that Services ID ("Return URLs")
#   APPLE_CLIENT_IDS     JSON list of ids tokens may be for: the Services ID, later the iOS Bundle ID
#   APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY  a key with "Sign in with Apple" enabled; the .p8 file's
#     text goes in APPLE_PRIVATE_KEY with its line breaks written as 
. This one IS a secret.
#     Needed so deleted accounts' Apple links are revoked at Apple (App Store rule).
APPLE_WEB_CLIENT_ID=
APPLE_REDIRECT_URI=
APPLE_CLIENT_IDS=[]
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
